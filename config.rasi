configuration {
    terminal: "alacritty";
    modi: "drun";
    show-icons: true;
    display-drun: "";
    drun-display-format: "{name}";
    icon-theme: "Papirus-Dark";
}

* {
    bg: #1a1b26dd;
    fg: #c0caf5;
    blue: #7aa2f7;
    purple: #bb9af7;
    cyan: #7dcfff;
    
    background-color: transparent;
    text-color: @fg;
}

window {
    background-color: @bg;
    border: 2px solid;
    border-color: @blue;
    border-radius: 12px;
    width: 28%;
    padding: 0;
    transparency: "real";
}

mainbox {
    background-color: transparent;
    padding: 15px;
}

inputbar {
    background-color: #24283b99;
    border: 2px solid;
    border-color: @purple;
    border-radius: 8px;
    padding: 8px 12px;
    margin: 0 0 12px 0;
    children: [prompt, entry];
}

prompt {
    background-color: transparent;
    text-color: @cyan;
    font: "JetBrainsMono Nerd Font Bold 10";
    padding: 0 10px 0 0;
}

entry {
    background-color: transparent;
    text-color: @fg;
    placeholder: "Search applications...";
    placeholder-color: #565f89;
    font: "JetBrainsMono Nerd Font 9";
}

listview {
    background-color: transparent;
    lines: 6;
    spacing: 5px;
    cycle: false;
}

element {
    background-color: transparent;
    text-color: @fg;
    border-radius: 6px;
    padding: 6px 10px;
    orientation: horizontal;
}

element normal.normal {
    background-color: transparent;
    text-color: @fg;
}

element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @blue;
    text-color: #1a1b26;
    border: 2px solid;
    border-color: @cyan;
}

element-icon {
    background-color: transparent;
    size: 24px;
    padding: 0 8px 0 0;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    font: "JetBrainsMono Nerd Font 9";
}
